# Facebook API Configuration
# Get your access token from: https://developers.facebook.com/tools/explorer/
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
# Public Meta app id (emitted as fb:app_id when set). Safe to expose in HTML.
FACEBOOK_APP_ID=your_facebook_app_id_here
# Server/local only - used by npm run token:refresh. Never expose to the browser.
FACEBOOK_APP_SECRET=your_facebook_app_secret_here
FACEBOOK_PAGE_ID=townsvillebushwalkingclub

NODE_ENV=development
#NODE_ENV=production

# Server Configuration
PORT=3000

# CORS allowed origins
CORS_ALLOWED_ORIGINS=https://townsvillebushwalkingclub.com,https://www.townsvillebushwalkingclub.com,http://localhost:3000/

# Secret for POST /api/cache/clear and npm run cache:clear (required in production)
CACHE_CLEAR_SECRET=your_long_random_secret_here

# Used by npm run cache:clear when targeting production
NEXT_PUBLIC_SITE_URL=https://events.townsvillebushwalkingclub.com
