{
  "name": "tbwc",
  "version": "2.1.3",
  "description": "Townsville Bushwalking Club Events Calendar and API",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm run covers:manifest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "covers:sync": "pnpm exec tsx tools/sync-covers.ts",
    "month:sync": "pnpm exec tsx tools/sync-month.ts",
    "covers:manifest": "pnpm exec tsx tools/generate-cover-manifest.ts",
    "token:refresh": "pnpm exec tsx tools/get-long-lived-token.ts",
    "download:history": "pnpm exec tsx tools/download-historical-events.ts",
    "sync:cancelled": "pnpm exec tsx tools/sync-cancelled-events.ts",
    "cache:clear": "pnpm exec tsx tools/clear-cache.ts"
  },
  "keywords": [
    "townsville",
    "events",
    "calendar",
    "bushwalking",
    "hiking",
    "walking",
    "outdoors",
    "nature",
    "adventure",
    "explore",
    "exploration"
  ],
  "author": "Luen Warneke",
  "license": "ISC",
  "dependencies": {
    "@next/third-parties": "16.3.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.2",
    "next": "16.3.4",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "postcss": "^8.5.26",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "5.0.9",
    "js-yaml": "4.3.2"
  },
  "packageManager": "pnpm@10.33.0"
}
