{
  "name": "tbwc",
  "version": "2.1.2",
  "description": "Townsville Bushwalking Club Events Calendar and API",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "covers:sync": "npx tsx tools/sync-covers.ts",
    "month:sync": "npx tsx tools/sync-month.ts",
    "covers:manifest": "npx tsx tools/generate-cover-manifest.ts",
    "prebuild": "npm run covers:manifest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "token:refresh": "npx tsx tools/get-long-lived-token.ts",
    "download:history": "npx tsx tools/download-historical-events.ts",
    "sync:cancelled": "npx tsx tools/sync-cancelled-events.ts",
    "poster:send": "npx tsx tools/send-poster-pdf.ts"
  },
  "keywords": [
    "townsville",
    "events",
    "calendar",
    "bushwalking",
    "hiking",
    "walking",
    "outdoors",
    "nature",
    "adventure",
    "explore",
    "exploration"
  ],
  "author": "Luen Warneke",
  "license": "ISC",
  "dependencies": {
    "@next/third-parties": "16.2.9",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "date-fns": "^4.4.0",
    "next": "16.2.9",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.9",
    "nodemailer": "^8.0.10",
    "puppeteer": "^25.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.15"
  }
}
